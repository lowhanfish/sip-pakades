APP_NAME=SIP-PAKADES
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=sippakades

JWT_SECRET_KEY=change_this_to_a_long_random_secret_key
JWT_ALGORITHM=HS256
# Kunci enkripsi NIK (wajib di production). Buat dengan:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
STORAGE_DIR=./storage
BACKUP_DIR=./backups

# --- Tanda Tangan Elektronik (TTE) ---
# disabled | mock (hanya development) | live
TTE_MODE=disabled
TTE_BASE_URL=https://esignkonsel.konaweselatankab.go.id
# Kredensial aplikasi dari admin gateway. Isi HANYA di backend/.env, jangan di-commit.
TTE_CLIENT_ID=
TTE_CLIENT_SECRET=
# TTE_ORIGIN=
PUBLIC_BASE_URL=http://localhost:3000
